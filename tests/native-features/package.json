{
  "name": "test-native-features",
  "version": "1.27.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "one build",
    "dev": "one dev",
    "ios": "EXPO_NO_TELEMETRY=true one run:ios",
    "prebuild:native": "one prebuild",
    "test-ios": "bun run test-ios:dev && bun run test-ios:prod",
    "test-ios:dev": "TEST_ONLY=dev TEST_ENV=dev DEV_PORT=8081 vitest --config ./vitest.config.ios.ts --run",
    "test-ios:prod": "TEST_ONLY=prod TEST_ENV=prod DEV_PORT=8081 vitest --config ./vitest.config.ios.ts --run"
  },
  "dependencies": {
    "@react-navigation/native": "~7.3.16",
    "@vxrn/native": "workspace:*",
    "expo": "58.0.0-canary-20260909-ea7a89a",
    "expo-build-properties": "58.0.0-canary-20260909-ea7a89a",
    "expo-clipboard": "58.0.0-canary-20260909-ea7a89a",
    "expo-modules-core": "58.0.0-canary-20260909-ea7a89a",
    "one": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.27.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "webdriverio": "^9.5.4"
  }
}
