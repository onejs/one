{
  "name": "test-native-features",
  "version": "1.26.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "one build",
    "dev": "one dev",
    "ios": "EXPO_NO_TELEMETRY=true one run:ios",
    "prebuild:native": "one prebuild",
    "test-ios": "bun run test-ios:dev && bun run test-ios:prod",
    "test-ios:dev": "TEST_ONLY=dev TEST_ENV=dev DEV_PORT=8081 vitest --config ./vitest.config.ios.ts --run",
    "test-ios:prod": "TEST_ONLY=prod TEST_ENV=prod DEV_PORT=8081 vitest --config ./vitest.config.ios.ts --run"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.1",
    "@react-navigation/native": "8.0.0-alpha.44",
    "@vxrn/native": "workspace:*",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-modules-core": "~57.0.10",
    "one": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.27.0",
    "vite": "^8.2.2",
    "one-native": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "webdriverio": "^9.5.4"
  }
}
