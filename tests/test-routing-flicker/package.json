{
  "name": "test-routing-flicker",
  "version": "1.24.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "one build",
    "clean": "one clean",
    "dev": "one dev",
    "dev:clean": "bun run dev --clean",
    "prod": "one build && one serve",
    "serve": "one serve",
    "test": "bun run test:spa && bun run test:ssg && bun run test:ssr",
    "test:spa": "DEFAULT_RENDER_MODE=spa TEST_ONLY=prod bun run vitest --run --reporter=verbose --color=false",
    "test:ssg": "DEFAULT_RENDER_MODE=ssg TEST_ONLY=prod bun run vitest --run --reporter=verbose --color=false",
    "test:ssr": "DEFAULT_RENDER_MODE=ssr TEST_ONLY=prod bun run vitest --run --reporter=verbose --color=false",
    "test:all": "bun run test:spa && bun run test:ssg",
    "test:dev": "TEST_ONLY=dev bun run vitest --run --reporter=verbose --color=false tests/dev-navigation-flicker.test.ts",
    "test:dev:ssg": "DEFAULT_RENDER_MODE=ssg TEST_ONLY=dev bun run vitest --run --reporter=verbose --color=false tests/dev-navigation-flicker.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/native": "~7.3.16",
    "@tamagui/config": "2.6.2",
    "@vxrn/color-scheme": "workspace:*",
    "expo": "~57.0.11",
    "one": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-web": "^0.21.2",
    "tamagui": "2.6.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "get-port-please": "^3.1.2",
    "playwright": "^1.58.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
