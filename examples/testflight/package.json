{
  "name": "example-testflight",
  "version": "2.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "one patch || true",
    "android": "one run:android",
    "build:web": "one build",
    "clean": "one clean",
    "db:generate": "drizzle-kit generate --config ./code/db/drizzle.config.ts",
    "db:init": "$npm_execpath db:generate && $npm_execpath db:push && $npm_execpath db:seed",
    "db:migrate": "dotenvx run -f .env -- tsx ./code/db/run-migrations.ts",
    "db:push": "drizzle-kit push --config ./code/db/drizzle.config.ts",
    "db:seed": "dotenvx run -f .env -- tsx ./code/db/seed.ts",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "ios": "one run:ios",
    "prebuild:native": "one prebuild",
    "serve": "one serve",
    "upgrade:tamagui": "$npm_execpath up '*tamagui*' '@tamagui/*'"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.12.1",
    "@callstack/liquid-glass": "^0.8.1",
    "@react-navigation/native": "8.0.0-alpha.51",
    "@react-navigation/native-stack": "8.0.0-alpha.59",
    "@tamagui/config": "3.1.4",
    "@vxrn/color-scheme": "workspace:*",
    "better-sqlite3": "^11.2.1",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.24.2",
    "drizzle-orm": "^0.33.0",
    "one": "workspace:*",
    "postgres": "^3.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "~0.13.0",
    "tamagui": "3.1.4",
    "@tamagui/helpers-icon": "3.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "next",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/template": "^0.88.0",
    "@tamagui/vite-plugin": "3.1.4",
    "tsx": "^4.20.6",
    "vite": "^8.2.2",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "@react-navigation/native": "8.0.0-alpha.51",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.57",
    "@react-navigation/native-stack": "8.0.0-alpha.59",
    "@react-navigation/drawer": "8.0.0-alpha.58",
    "@react-navigation/elements": "3.0.0-alpha.55",
    "@react-navigation/routers": "8.0.0-alpha.21",
    "@react-navigation/core": "8.0.0-alpha.41"
  }
}
