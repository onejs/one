{
  "name": "@vxrn/react-native-prebuilt",
  "version": "1.24.2",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./vendor/react-native-0.74.1": "./vendor/react-native-0.74.1/index.js",
    "./vendor/react-18.3.1": "./vendor/react-18.3.1/index.js",
    "./vendor/react-jsx-runtime-18.3.1": "./vendor/react-jsx-runtime-18.3.1/index.js"
  },
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "vendor",
    "src",
    "types"
  ],
  "scripts": {
    "build": "tamagui-build",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "typecheck": "tsc --noEmit",
    "watch": "tamagui-build --watch"
  },
  "dependencies": {
    "@vxrn/utils": "workspace:*",
    "@vxrn/vite-flow": "workspace:*",
    "@vxrn/vite-native-hmr": "workspace:*",
    "esbuild": "^0.25.12",
    "fs-extra": "^11.2.0",
    "import-meta-resolve": "^4.1.0"
  },
  "devDependencies": {
    "@tamagui/build": "2.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "tsx": "^4.20.6"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
