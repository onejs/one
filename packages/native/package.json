{
  "name": "@vxrn/native",
  "version": "1.27.1",
  "type": "module",
  "description": "Native SwiftUI, Jetpack Compose, navigation, and platform interfaces for One and React Native.",
  "license": "MIT",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "react-native": "./dist/esm/index.native.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "types",
    "dist",
    "ios",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "cpp",
    "VxrnNative.podspec",
    "react-native.config.cjs",
    "schema.json"
  ],
  "scripts": {
    "build": "tamagui-build && bun codegen/staticSpecs.ts",
    "clean": "tamagui-build clean",
    "typecheck": "tsc --noEmit --composite false",
    "test": "vitest run",
    "generate": "bun codegen/generate.ts",
    "generate:check": "bun codegen/generate.ts --check",
    "coverage": "bun codegen/coverage.ts",
    "measure": "bun codegen/measure.ts"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
