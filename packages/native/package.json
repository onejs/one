{
  "name": "@vxrn/native",
  "version": "1.27.1",
  "type": "module",
  "description": "Native SwiftUI, Jetpack Compose, navigation, and platform interfaces for One and React Native.",
  "license": "MIT",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "types",
    "dist",
    "ios",
    "android/build.gradle",
    "android/src",
    "cpp",
    "VxrnNative.podspec",
    "react-native.config.cjs",
    "schema.json"
  ],
  "scripts": {
    "build": "tamagui-build",
    "clean": "tamagui-build clean",
    "typecheck": "tsc --noEmit --composite false",
    "test": "vitest run",
    "generate": "bun codegen/generate.ts",
    "generate:check": "bun codegen/generate.ts --check",
    "coverage": "bun codegen/coverage.ts",
    "measure": "bun codegen/measure.ts"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./color": {
      "types": "./types/color/index.d.ts",
      "react-native": "./dist/esm/color/index.native.js",
      "import": "./dist/esm/color/index.mjs",
      "require": "./dist/cjs/color/index.cjs"
    },
    "./zoom": {
      "types": "./types/zoom/index.d.ts",
      "react-native": "./dist/esm/zoom/index.native.js",
      "import": "./dist/esm/zoom/index.mjs",
      "require": "./dist/cjs/zoom/index.cjs"
    },
    "./toolbar": {
      "types": "./types/toolbar/index.d.ts",
      "react-native": "./dist/esm/toolbar/index.native.js",
      "import": "./dist/esm/toolbar/index.mjs",
      "require": "./dist/cjs/toolbar/index.cjs"
    },
    "./menu": {
      "types": "./types/menu/index.d.ts",
      "react-native": "./dist/esm/menu/index.native.js",
      "import": "./dist/esm/menu/index.mjs",
      "require": "./dist/cjs/menu/index.cjs"
    },
    "./split-view": {
      "types": "./types/split-view/index.d.ts",
      "react-native": "./dist/esm/split-view/index.native.js",
      "import": "./dist/esm/split-view/index.mjs",
      "require": "./dist/cjs/split-view/index.cjs"
    },
    "./package.json": "./package.json",
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "~0.87.1",
    "react-native-screens": ">=4.25.0",
    "react-native-safe-area-context": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tamagui/build": "3.0.0-beta.1309.1",
    "react-native-web": "^0.21.2",
    "vitest": "^4.1.0"
  },
  "codegenConfig": {
    "name": "OneNativeSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.onejs.onenative"
    },
    "ios": {
      "componentProvider": {
        "OneNativeMenu": "OneNativeMenuComponentView",
        "OneNativeTabs": "OneNativeTabsComponentView",
        "OneNativeTab": "OneNativeTabComponentView",
        "OneNativeList": "OneNativeListComponentView",
        "OneNativeScrollView": "OneNativeScrollViewComponentView",
        "OneNativeLazyVStack": "OneNativeLazyVStackComponentView",
        "OneNativeLazyHStack": "OneNativeLazyHStackComponentView",
        "OneNativePicker": "OneNativePickerComponentView",
        "OneNativeDatePicker": "OneNativeDatePickerComponentView",
        "OneNativeColorPicker": "OneNativeColorPickerComponentView",
        "OneNativeToggle": "OneNativeToggleComponentView",
        "OneNativeSlider": "OneNativeSliderComponentView",
        "OneNativeStepper": "OneNativeStepperComponentView",
        "OneNativeText": "OneNativeTextComponentView",
        "OneNativeLabel": "OneNativeLabelComponentView",
        "OneNativeButton": "OneNativeButtonComponentView",
        "OneNativeProgressView": "OneNativeProgressViewComponentView",
        "OneNativeGauge": "OneNativeGaugeComponentView",
        "OneNativeImage": "OneNativeImageComponentView",
        "OneNativeShareLink": "OneNativeShareLinkComponentView",
        "OneNativeContentUnavailableView": "OneNativeContentUnavailableViewComponentView",
        "OneNativeVideoPlayer": "OneNativeVideoPlayerComponentView",
        "OneNativePhotosPicker": "OneNativePhotosPickerComponentView",
        "OneNativeWebView": "OneNativeWebViewComponentView",
        "OneNativeMap": "OneNativeMapComponentView",
        "OneNativeTextField": "OneNativeTextFieldComponentView",
        "OneNativeSecureField": "OneNativeSecureFieldComponentView",
        "OneNativeAlert": "OneNativeAlertComponentView",
        "OneNativeConfirmationDialog": "OneNativeConfirmationDialogComponentView",
        "OneNativeQuickLook": "OneNativeQuickLookComponentView",
        "OneNativeSheet": "OneNativeSheetComponentView",
        "OneNativeSheetContent": "OneNativeSheetContentComponentView",
        "OneNativeHost": "OneNativeHostComponentView",
        "OneNativeZStack": "OneNativeZStackComponentView",
        "OneNativeSpacer": "OneNativeSpacerComponentView",
        "OneNativeForm": "OneNativeFormComponentView",
        "OneNativeSection": "OneNativeSectionComponentView",
        "OneNativeLabeledContent": "OneNativeLabeledContentComponentView",
        "OneNativeGlass": "OneNativeGlassComponentView",
        "OneNativeContainerSlot": "OneNativeContainerSlotComponentView",
        "OneNativePopover": "OneNativePopoverComponentView",
        "OneNativePopoverContent": "OneNativePopoverContentComponentView"
      }
    }
  }
}
