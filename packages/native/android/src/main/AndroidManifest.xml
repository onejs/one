<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- camera captures write into the app cache through this provider; the
    manifest merger carries it into the app, with the app's own id. -->
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.one-native.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/one_native_file_paths" />
        </provider>
    </application>
</manifest>
