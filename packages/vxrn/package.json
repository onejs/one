{
  "name": "vxrn",
  "version": "2.12.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./react-native-commands": "./react-native-commands.cjs",
    "./expo-plugin": "./expo-plugin.cjs",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./dev": {
      "types": "./types/exports/dev.d.ts",
      "default": "./dist/exports/dev.mjs"
    },
    "./build": {
      "types": "./types/exports/build.d.ts",
      "default": "./dist/exports/build.mjs"
    },
    "./serve": {
      "types": "./types/exports/serve.d.ts",
      "default": "./dist/exports/serve.mjs"
    },
    "./loadEnv": {
      "types": "./types/exports/loadEnv.d.ts",
      "default": "./dist/exports/loadEnv.mjs"
    },
    "./vite-plugin": {
      "types": "./types/vxrn-vite-plugin.d.ts",
      "default": "./dist/vxrn-vite-plugin.mjs"
    },
    "./native-source-contract": {
      "types": "./types/native-source-contract.d.ts",
      "default": "./dist/native-source-contract.mjs"
    },
    "./swift-package-id": {
      "types": "./types/swift-package-id.d.ts",
      "default": "./dist/swift-package-id.mjs"
    },
    "./background-computation": {
      "types": "./types/backgroundComputation.d.ts",
      "default": "./dist/backgroundComputation.mjs"
    },
    "./background-computation-native": {
      "types": "./types/backgroundComputationNative.d.ts",
      "default": "./dist/backgroundComputationNative.mjs"
    }
  },
  "module": "dist",
  "source": "src/index.ts",
  "types": "./types/index.d.ts",
  "bin": {
    "vxrn": "run.mjs"
  },
  "files": [
    "src",
    "types",
    "dist",
    "run.mjs",
    "expo-plugin.cjs",
    "native-project-patches.cjs",
    "react-native-commands.cjs"
  ],
  "scripts": {
    "build": "tamagui-build",
    "watch": "bun run build --watch",
    "check": "depcheck",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@jridgewell/remapping": "^2.3.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@react-native/codegen": "^0.88.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-config": "^20.2.0",
    "@react-native/dev-middleware": "^0.88.0",
    "@vxrn/compiler": "workspace:*",
    "@vxrn/debug": "workspace:*",
    "@vxrn/query-string": "workspace:*",
    "@vxrn/resolve": "workspace:*",
    "@vxrn/url-parse": "workspace:*",
    "@vxrn/utils": "workspace:*",
    "@vxrn/vendor": "workspace:*",
    "@vxrn/vite-flow": "workspace:*",
    "citty": "^0.1.6",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "env-editor": "^1.1.0",
    "es-module-lexer": "^1.3.0",
    "oxc-parser": "^0.112.0",
    "oxc-transform": "^0.148.0",
    "oxc-transform-react": "^0.145.0",
    "fast-glob": "^3.3.3",
    "image-size": "2.0.3",
    "magic-string": "^0.30.21",
    "micromatch": "^4.0.8",
    "find-node-modules": "^2.1.3",
    "fs-extra": "^11.2.0",
    "get-port-please": "^3.1.2",
    "hono": "^4.13.11",
    "perfect-debounce": "^1.0.0",
    "picocolors": "^1.0.0",
    "pkg-types": "^1.0.3",
    "rolldown": "^1.2.8",
    "semver": "^7.6.3",
    "sharp": "^0.35.5",
    "vite": "^8.2.2",
    "ws": "^8.21.0",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@jridgewell/gen-mapping": "^0.3.5",
    "@tamagui/build": "3.1.10",
    "@types/find-node-modules": "^2.1.2",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "depcheck": "^1.4.7",
    "hermes-compiler": "260318099.0.4",
    "metro-source-map": "0.87.1",
    "react-native": "0.88.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "@vxrn/vite-plugin-metro": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vxrn/vite-plugin-metro": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@vxrn/vite-plugin-metro": {
      "optional": true
    }
  }
}
