{
  "name": "@vxrn/utils",
  "version": "2.18.0",
  "sideEffects": false,
  "type": "module",
  "types": "./types/index.d.ts",
  "main": "dist/cjs",
  "module": "dist/esm",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": "./dist/esm/index.native.js",
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./publicEnv": {
      "types": "./types/publicEnv.d.ts",
      "import": "./dist/esm/publicEnv.mjs",
      "require": "./dist/cjs/publicEnv.cjs"
    },
    "./platformEnv": {
      "types": "./types/platformEnv.d.ts",
      "import": "./dist/esm/platformEnv.mjs",
      "require": "./dist/cjs/platformEnv.cjs"
    },
    "./desktopReactNativeResolve": {
      "types": "./types/desktopReactNativeResolve.d.ts",
      "import": "./dist/esm/desktopReactNativeResolve.mjs",
      "require": "./dist/cjs/desktopReactNativeResolve.cjs"
    },
    "./empty": {
      "import": "./empty.js",
      "require": "./empty.js"
    },
    "./nativeAppManifest": {
      "types": "./types/nativeAppManifest.d.ts",
      "import": "./dist/esm/nativeAppManifest.mjs",
      "require": "./dist/cjs/nativeAppManifest.cjs"
    },
    "./metroTypes": {
      "types": "./types/metroTypes.d.ts",
      "import": "./dist/esm/metroTypes.mjs",
      "require": "./dist/cjs/metroTypes.cjs"
    }
  },
  "files": [
    "src",
    "empty.js",
    "dist",
    "types"
  ],
  "scripts": {
    "build": "tamagui-build",
    "watch": "tamagui-build --watch",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "lint:fix": "oxfmt -c ../../.oxfmtrc.jsonc src && oxlint -c ../../.oxlintrc.json --fix src",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vxrn/debug": "workspace:*",
    "@vxrn/resolve": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tamagui/build": "3.3.3",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
