{
  "name": "lllink",
  "version": "2.18.0",
  "type": "module",
  "module": "dist",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "lllink": "dist/index.mjs"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tamagui-build --skip-types --skip-native",
    "watch": "bun run build --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "lint:fix": "oxfmt -c ../../.oxfmtrc.jsonc src && oxlint -c ../../.oxlintrc.json --fix src"
  },
  "devDependencies": {
    "@tamagui/build": "3.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
