<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- normal install-time permission, merged into the app manifest;
         the api-conventions section 6 exception for install-time permissions -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- fastest sensor delivery above 200 hz is an install-time permission. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- android 11 package visibility: Browser finds the Custom Tabs browser
         through this service action -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <!-- camera captures write into the app cache through this provider; the
    manifest merger carries it into the app, with the app's own id. -->
    <application>
        <provider
            android:name="dev.onejs.onenative.OneNativeFileProvider"
            android:authorities="${applicationId}.one-native.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/one_native_file_paths" />
        </provider>
    </application>
</manifest>
