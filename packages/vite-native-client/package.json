{
  "name": "@vxrn/vite-native-client",
  "version": "1.27.1",
  "sideEffects": [
    "*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "scripts": {
    "build": "tamagui-build",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "typecheck": "tsc --noEmit",
    "watch": "tamagui-build --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@tamagui/build": "3.0.0-beta.1432.1",
    "react-native": "0.87.1"
  },
  "peerDependencies": {
    "react-native": "^0.87.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
