{
  "name": "@vxrn/emitter",
  "version": "2.18.0",
  "sideEffects": false,
  "source": "src/index.ts",
  "types": "./src/index.ts",
  "main": "dist/cjs",
  "module": "dist/esm",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tamagui-build --skip-types",
    "watch": "tamagui-build --skip-types --watch",
    "lint:fix": "oxfmt -c ../../.oxfmtrc.jsonc src && oxlint -c ../../.oxlintrc.json --fix src",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@tamagui/build": "3.3.3",
    "react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
