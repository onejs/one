{
  "name": "@vxrn/vite-plugin-metro",
  "version": "1.27.1",
  "sideEffects": false,
  "type": "module",
  "main": "dist/cjs",
  "module": "dist/esm",
  "source": "src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./rn-commands": {
      "types": "./types/rn-commands/index.d.ts",
      "import": "./dist/esm/rn-commands/index.mjs",
      "require": "./dist/cjs/rn-commands/index.cjs"
    },
    "./babel-transformer": {
      "types": "./types/transformer/babel-transformer.d.ts",
      "import": "./dist/esm/transformer/babel-transformer.mjs",
      "require": "./dist/cjs/transformer/babel-transformer.cjs"
    },
    "./transformer/metroNativeWorker": {
      "types": "./types/transformer/metroNativeWorker.d.ts",
      "import": "./dist/esm/transformer/metroNativeWorker.mjs",
      "require": "./dist/cjs/transformer/metroNativeWorker.cjs"
    },
    "./metroNativeWorker": {
      "types": "./types/transformer/metroNativeWorker.d.ts",
      "import": "./dist/esm/transformer/metroNativeWorker.mjs",
      "require": "./dist/cjs/transformer/metroNativeWorker.cjs"
    },
    "./babel-plugins/import-meta-env-plugin": {
      "types": "./types/babel-plugins/import-meta-env-plugin.d.ts",
      "import": "./dist/esm/babel-plugins/import-meta-env-plugin.mjs",
      "require": "./dist/cjs/babel-plugins/import-meta-env-plugin.cjs"
    },
    "./empty": {
      "import": "./empty.js",
      "require": "./empty.js"
    }
  },
  "files": [
    "src",
    "types",
    "empty.js",
    "dist"
  ],
  "scripts": {
    "build": "tamagui-build",
    "build:workaround-fix-nodejs-22-defaults-to-esm": "echo '{\n  \"type\": \"commonjs\"\n}' > dist/cjs/package.json",
    "watch": "bun run build --watch",
    "check": "depcheck",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "metro": "^0.87.0",
    "metro-config": "^0.87.0",
    "react-native": "0.87.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/helper-plugin-utils": "^7.27.1",
    "@jridgewell/remapping": "^2.3.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@oxc-project/runtime": "^0.112.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/metro-config": "^0.87.1",
    "@vxrn/compiler": "workspace:*",
    "@vxrn/debug": "workspace:*",
    "@vxrn/utils": "workspace:*",
    "esbuild": "^0.25.12",
    "flow-parser": "^0.331.0",
    "launch-editor": "^2.10.0",
    "magic-string": "^0.30.21",
    "micromatch": "^4.0.8",
    "oxc-parser": "^0.112.0",
    "oxc-transform": "^0.148.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@react-native/dev-middleware": "^0.87.1",
    "@tamagui/build": "3.0.0-beta.1309.1",
    "@types/babel__helper-plugin-utils": "^7",
    "@types/node": "^24.10.0",
    "depcheck": "^1.4.7",
    "metro": "^0.87.0",
    "metro-config": "^0.87.0",
    "react-native": "0.87.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
