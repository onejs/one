+#pragma mark - UITab content sync (One fork)
+
+/**
+ * Mirror a screen's title and badge onto its installed `UITab`, repainting only when something
+ * actually changed. Called from the screen component view after it updates the legacy
+ * `tabBarItem`; pre-install (no tab yet) and on the legacy path this is a no-op.
+ */
+- (void)syncTabContentForScreenView:(RNSTabsScreenComponentView *)screenView
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(27_0)
+  if (@available(iOS 27, *)) {
+    UITab *tab = [self findTabForScreenKey:screenView.screenKey];
+    if (tab == nil) {
+      return;
+    }
+    // The controller title tracks the evaluated title (custom or system-item default).
+    NSString *title = screenView.controller.title ?: @"";
+    NSString *badge = screenView.badgeValue;
+    BOOL changed = NO;
+    if (![tab.title isEqualToString:title]) {
+      tab.title = title;
+      changed = YES;
+    }
+    if (!((tab.badgeValue == nil && badge == nil) || [tab.badgeValue isEqualToString:badge])) {
+      tab.badgeValue = badge;
+      changed = YES;
+    }
+    if (changed) {
+      [self repaintInstalledTabs];
+    }
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(27_0)
