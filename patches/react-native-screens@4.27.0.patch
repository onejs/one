+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(27_0)
+  if (@available(iOS 27, *)) {
+    UITab *tab = [self findTabForScreenKey:screenView.screenKey];
+    if (tab == nil) {
+      return;
+    }
+    UITabBarItem *tabBarItem = screenView.controller.tabBarItem;
+    BOOL changed = NO;
+    if (tab.image != tabBarItem.image) {
+      tab.image = tabBarItem.image;
+      changed = YES;
+    }
+    if (@available(iOS 26.1, *)) {
+      if (tab.selectedImage != tabBarItem.selectedImage) {
+        tab.selectedImage = tabBarItem.selectedImage;
+        changed = YES;
+      }
+    }
+    if (changed) {
+      [self repaintInstalledTabs];
+    }
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(27_0)
