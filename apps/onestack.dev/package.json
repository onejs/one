{
  "name": "site",
  "version": "1.25.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "files": [],
  "scripts": {
    "generate:og": "bun scripts/generate-og-images.tsx",
    "build:web": "bun scripts/generate-og-images.tsx && one build",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "serve": "one serve",
    "serve:railway": "one serve --host 0.0.0.0",
    "subset-font-pn": "tsx ./helpers/subset-font.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:dev && bun run test:prod",
    "test:dev": "TEST_ONLY=dev bun run vitest run --mode dev",
    "test:prod": "TEST_ONLY=prod bun run vitest run --mode prod"
  },
  "dependencies": {
    "@docsearch/react": "^3.9.0",
    "@react-navigation/native": "~7.3.16",
    "@supabase/supabase-js": "^2.44.4",
    "@tamagui/lucide-icons-2": "2.6.2",
    "@tamagui/react-native-web": "2.6.2",
    "@tamagui/themes": "2.6.2",
    "@tamagui/use-store": "2.6.2",
    "@vxrn/color-scheme": "workspace:*",
    "@vxrn/mdx-rust": "workspace:*",
    "body-scroll-lock": "^4.0.0-beta.0",
    "one": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "tamagui": "2.6.2"
  },
  "devDependencies": {
    "@algolia/client-search": "^5.8.1",
    "@tamagui/vite-plugin": "2.6.2",
    "@vxrn/test": "workspace:*",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.2",
    "playwright": "^1.58.2",
    "satori": "^0.19.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.4.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
