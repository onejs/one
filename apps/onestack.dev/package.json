{
  "name": "site",
  "version": "2.7.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "files": [],
  "scripts": {
    "generate:og": "bun scripts/generate-og-images.tsx",
    "build:web": "bun scripts/prune-stale-sheet.ts && bun scripts/generate-og-images.tsx && one build",
    "deploy": "bun scripts/deploy-site.ts",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "serve": "one serve",
    "subset-font-pn": "tsx ./helpers/subset-font.ts",
    "typecheck": "tsc --noEmit",
    "check:snippets": "bun scripts/check-doc-snippets.ts",
    "test": "bun run test:dev && bun run test:prod",
    "test:dev": "TEST_ONLY=dev bun run vitest run --mode dev",
    "test:prod": "TEST_ONLY=prod bun run vitest run --mode prod",
    "build:web:framework": "one build"
  },
  "dependencies": {
    "@docsearch/react": "^3.9.0",
    "@callstack/liquid-glass": "^0.8.1",
    "@react-navigation/native": "8.0.0-alpha.51",
    "@supabase/supabase-js": "^2.44.4",
    "@tamagui/react-native-web": "3.0.12",
    "@tamagui/sheet": "3.0.12",
    "@tamagui/themes": "3.0.12",
    "@tamagui/use-store": "3.0.12",
    "@vxrn/color-scheme": "2.7.2",
    "@vxrn/mdx-rust": "2.7.2",
    "body-scroll-lock": "^4.0.0-beta.0",
    "one": "2.7.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-screens": "~4.30.0",
    "tamagui": "3.0.12",
    "@tamagui/helpers-icon": "3.0.12",
    "react-native-svg": "15.15.4",
    "@tamagui/config": "3.0.12",
    "@tamagui/react-native-svg": "3.0.12",
    "@tamagui/react-native-web-lite": "3.0.12",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@algolia/client-search": "^5.8.1",
    "@tamagui/vite-plugin": "3.0.12",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.2",
    "playwright": "^1.58.2",
    "satori": "^0.19.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.4.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.0",
    "wrangler": "4.95.0",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "24.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
