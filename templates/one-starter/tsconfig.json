{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "allowArbitraryExtensions": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["dom", "esnext"],
    "types": ["bun"],
    "paths": {
      "~/*": ["./*"]
    }
  },
  "typeAcquisition": {
    "enable": true
  },
  "exclude": ["node_modules", "packages", "dist"]
}
