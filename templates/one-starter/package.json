{
  "name": "example-one-starter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "targets": [
    "native",
    "web"
  ],
  "scripts": {
    "dev": "bun env.ts -- one dev",
    "build": "NODE_OPTIONS=--import=orez-lite/cloudflare/node-wasm-loader one build",
    "generate": "bun run generate:migrations && bun run generate:types",
    "generate:types": "on-zero generate data",
    "generate:migrations": "drizzle-kit generate --config=database/drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "one patch",
    "ios": "one run:ios",
    "android": "one run:android",
    "prebuild:native": "bun env.ts -- one prebuild",
    "check": "bun run typecheck && bun run lint",
    "lint": "oxlint app auth data database features helpers interface lib tamagui *.ts",
    "format": "oxfmt",
    "serve": "NODE_ENV=production bun --preload orez-lite/cloudflare/bun-wasm-loader serve.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.6.30",
    "@better-auth/expo": "1.6.30",
    "@callstack/liquid-glass": "^0.8.1",
    "@react-native/assets-registry": "0.87.1",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.50",
    "@react-navigation/core": "8.0.0-alpha.34",
    "@react-navigation/elements": "3.0.0-alpha.48",
    "@react-navigation/native": "8.0.0-alpha.44",
    "@react-navigation/native-stack": "8.0.0-alpha.52",
    "@rocicorp/zero": "1.9.0",
    "@o/database": "0.16.19-canary.1790768320875",
    "@o/env": "0.16.19-canary.1790768320875",
    "@o/helpers": "0.16.19-canary.1790768320875",
    "@tamagui/animations-css": "3.0.0-beta.1540.1",
    "@tamagui/animations-reanimated": "3.0.0-beta.1540.1",
    "@tamagui/config": "3.0.0-beta.1540.1",
    "@tamagui/native": "3.0.0-beta.1540.1",
    "@tamagui/toast": "3.0.0-beta.1540.1",
    "better-auth": "1.6.30",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "drizzle-zero-sqlite": "0.16.19-canary.1790768320875",
    "on-zero": "0.16.19-canary.1790768320875",
    "one": "2.0.0-beta.161.1",
    "orez-lite": "0.16.19-canary.1790768320875",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-reanimated": "~4.6.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "^1.2.2",
    "react-native-worklets": "~0.12.2",
    "s3mini": "^0.9.5",
    "server-only": "^0.0.1",
    "tamagui": "3.0.0-beta.1540.1",
    "valibot": "^1.1.0",
    "sf-symbols-typescript": "2.2.0",
    "@tamagui/menu": "3.0.0-beta.1540.1",
    "vxrn": "2.0.0-beta.161.1",
    "starter-mdx": "file:lib/mdx",
    "@op-engineering/op-sqlite": "18.2.5",
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/template": "^0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@tamagui/vite-plugin": "3.0.0-beta.1540.1",
    "@types/bun": "^1.2.16",
    "@types/node": "24.0.3",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "oxlint": "^1.31.0",
    "oxfmt": "^0.16.0",
    "babel-preset-expo": "58.0.0-canary-20260909-ea7a89a",
    "@types/react": "19.2.14",
    "@types/react-dom": "~19.1.7"
  },
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
    "@swc/core"
  ],
  "patchedDependencies": {
    "@react-navigation/bottom-tabs@8.0.0-alpha.50": "patches/@react-navigation%2Fbottom-tabs@8.0.0-alpha.50.patch",
    "react-native-screens@4.27.0": "patches/react-native-screens@4.27.0.patch",
    "react-native-reanimated@4.6.0": "patches/react-native-reanimated@4.6.0.patch",
    "@react-navigation/native-stack@8.0.0-alpha.52": "patches/@react-navigation%2Fnative-stack@8.0.0-alpha.52.patch",
    "react-native-keyboard-controller@1.22.5": "patches/react-native-keyboard-controller@1.22.5.patch"
  },
  "packageManager": "bun@1.4.2"
}
