# local development only; replace the secret and URLs before deployment
BETTER_AUTH_SECRET=one-starter-development-secret-change-before-deploy
BETTER_AUTH_URL=http://localhost:8081
ONE_SERVER_URL=http://localhost:8081
VITE_DEMO_MODE=1
VITE_ZERO_URL=http://localhost:4948
ZERO_APP_ID=takeout
ZERO_VERSION=1.9.0
ZERO_UPSTREAM_DB=postgresql://user:password@127.0.0.1:5533/postgres
ZERO_CVR_DB=postgresql://user:password@127.0.0.1:5533/zero_cvr
ZERO_CHANGE_DB=postgresql://user:password@127.0.0.1:5533/zero_cdb
ZERO_MUTATE_URL=http://localhost:8081/api/zero/push
ZERO_QUERY_URL=http://localhost:8081/api/zero/pull
ZERO_AUTH_JWKS_URL=http://localhost:8081/api/auth/jwks
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_APP_PUBLICATIONS=zero_takeout
